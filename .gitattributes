# 换行由 git 统一管理：索引里一律 LF，checkout 时按文件类型转换。
# 不写这些规则时，Windows 上 core.autocrlf=true 会把 deploy/*.cmd 与 scripts/*.mjs 存成 CRLF 进索引，
# 到 Linux 上 .sh 会报 “bad interpreter: /usr/bin/env bash^M”，.cmd 在 cmd.exe 里又会因为 LF 把标签解析错。
* text=auto

# ---- 一律 LF：Node 脚本、shell、python、配置、测试、文档 ----
*.sh       text eol=lf
*.bash     text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.js       text eol=lf
*.vue      text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.py       text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.sql      text eol=lf
*.conf     text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
*.target   text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
test/*     text eol=lf
scripts/*  text eol=lf
deploy/*   text eol=lf
deploy/cron.d/* text eol=lf
deploy/sql/*    text eol=lf

# ---- 必须 CRLF：cmd.exe 对 LF 的标签/goto 解析不可靠 ----
# 放最后：git 取最后一条匹配规则，这样才能覆盖上面 deploy/* 的 LF。
*.cmd      text eol=crlf
*.bat      text eol=crlf
*.ps1      text eol=crlf

# ---- 二进制不要做换行转换 ----
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.mp4   binary
*.webm  binary
*.m4a   binary
*.tgz   binary
*.zip   binary
*.db    binary
